# Covia mobile — environment (NOT committed)
# Copy from .env.example and fill in real values from your Supabase project.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Sign-In (Phase 10) — the "Web" OAuth client ID from Google Cloud
# Console. Must also be added to Supabase Auth → Providers → Google.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
